# Cloudflare cache rules. Code and HTML revalidate on every visit (ETag, so a 304 when unchanged);
# pinned libraries and fonts never change; data changes at most monthly with the GEE update.
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/dataset/*
  Cache-Control: public, max-age=86400
/sw.js
  Cache-Control: no-cache
